#!/bin/sh
set -eu

# Setup and update helper for this dotfiles repository.
#
# Responsibilities:
# * Ensure the dotfiles repository is present and up to date
# * Apply symlinks via dotlink
# * Ensure Rust and required Cargo tools are installed
#
# This script is intended to be idempotent: safe to run multiple times.
#
# Optional environment flags:
#   DOTSETUP_SKIP_RUST=1   Skip installing/updating Rust toolchain
#   DOTSETUP_SKIP_CARGO=1  Skip installing Cargo tools from cargo-install.txt
#
# Design note:
# This script intentionally avoids relying on any user-installed helper
# commands in ~/.local/bin or sourcing shell rc files (e.g. pathrc).
# It must be able to run in a minimal environment (fresh machine, CI) where
# PATH has not yet been customized by dotfiles.

DOTFILES_ROOT=${DOTFILES_ROOT:-"$HOME/.dotfiles"}
DOTFILES_REPO=${DOTFILES_REPO:-"https://github.com/ryumatag/dotfiles"}

CRATES_LIST_FILE="$DOTFILES_ROOT/cargo-install.txt"
DOTLINK="$DOTFILES_ROOT/bin/dotlink"

DOTSETUP_SKIP_RUST=${DOTSETUP_SKIP_RUST:-0}
DOTSETUP_SKIP_CARGO=${DOTSETUP_SKIP_CARGO:-0}

say() { printf "%s\n" "$*"; }
die() { printf "error: %s\n" "$*" >&2; exit 1; }

command -v git >/dev/null 2>&1 || die "missing command: git"

# Clone or update dotfiles repository.
if [ -d "$DOTFILES_ROOT/.git" ]; then
  say "dotfiles: updating $DOTFILES_ROOT"
  git -C "$DOTFILES_ROOT" remote set-url origin "$DOTFILES_REPO" >/dev/null 2>&1 || true
  git -C "$DOTFILES_ROOT" fetch --prune origin

  # Prefer fast-forward only.
  # Use upstream if configured; otherwise fall back to origin/main.
  if git -C "$DOTFILES_ROOT" rev-parse --abbrev-ref --symbolic-full-name "@{u}" >/dev/null 2>&1; then
    git -C "$DOTFILES_ROOT" pull --ff-only
  else
    git -C "$DOTFILES_ROOT" pull --ff-only origin main
  fi
else
  say "dotfiles: cloning into $DOTFILES_ROOT"
  git clone "$DOTFILES_REPO" "$DOTFILES_ROOT"
fi

# Apply symlinks via dotlink (do not rely on PATH).
[ -x "$DOTLINK" ] || die "dotlink not found or not executable: $DOTLINK"
say "dotlink: linking"
"$DOTLINK" link

# Ensure CARGO_HOME and make cargo/rustup visible without sourcing shell rc
# files.
export CARGO_HOME="${CARGO_HOME:=$HOME/.cargo}"
mkdir -p "$CARGO_HOME/bin"
export PATH="$CARGO_HOME/bin:$PATH"

# Rust toolchain (optional)
if [ "$DOTSETUP_SKIP_RUST" = "1" ]; then
  say "rust: skipped (DOTSETUP_SKIP_RUST=1)"
else
  if command -v rustup >/dev/null 2>&1; then
    say "rust: rustup already installed"
  else
    command -v curl >/dev/null 2>&1 || die "missing command: curl"
    say "rust: rustup not found; installing"
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
  fi

  # Keep toolchain stable available and selected.
  # (This is idempotent; repeated runs should be cheap.)
  rustup toolchain install stable --no-self-update
  rustup default stable
fi

# Cargo tools install (optional)
SKIP_CARGO_INSTALL=0

if [ "$DOTSETUP_SKIP_CARGO" = "1" ]; then
  say "cargo: skipped (DOTSETUP_SKIP_CARGO=1)"
  SKIP_CARGO_INSTALL=1
fi

if [ "$SKIP_CARGO_INSTALL" -eq 0 ] && ! command -v cargo >/dev/null 2>&1; then
  say "cargo: not found; skipping crate installs"
  SKIP_CARGO_INSTALL=1
fi

if [ "$SKIP_CARGO_INSTALL" -eq 0 ] && [ ! -f "$CRATES_LIST_FILE" ]; then
  say "cargo: crates list not found; skipping: $CRATES_LIST_FILE"
  SKIP_CARGO_INSTALL=1
fi

if [ "$SKIP_CARGO_INSTALL" -eq 0 ]; then
  say "cargo: installing crates from $CRATES_LIST_FILE"

  # Format: one crate per line.
  # * Empty lines and lines starting with # are ignored.
  # * Extra arguments per line are allowed (e.g., "--locked", "--features ...").
  #
  # Examples:
  #   ripgrep
  #   bat --locked
  #   cargo-fuzz --locked
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      ""|\#*) continue ;;
    esac

    # shellcheck disable=SC2086
    set -- $line
    crate=$1
    shift || true

    say "cargo: install $crate $*"
    cargo install "$crate" "$@"
  done <"$CRATES_LIST_FILE"
fi
