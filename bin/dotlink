#!/bin/sh

# Symlink manager for this dotfiles repository.
#
# Layers (highest priority first):
#   1) WORK_DOTFILES_ROOT/<os>/...
#   2) WORK_DOTFILES_ROOT/...
#   3) DOTFILES_ROOT/<os>/...
#   4) DOTFILES_ROOT/...
#
# The first existing path wins. Nonexistent candidates still establish the
# intended target path so that later creation stays consistent.
#
# Notes:
#   * zsh bootstrap keeps ~/.zshenv linked from .config/zsh/.zshenv
#   * Idempotent: running link/unlink repeatedly is safe
#   * OS detection is limited to macOS (darwin) today; more can be added later

set -eu

# Resolve this script's real path (follow symlinks) so DOTFILES_ROOT is stable.
SELF=$0
while [ -L "$SELF" ]; do
  target=$(readlink "$SELF")
  # shellcheck disable=SC1007
  case "$target" in
    /*) SELF=$target ;;
    *)  SELF=$(CDPATH= cd -- "$(dirname -- "$SELF")" && pwd)/$target ;;
  esac
done

# shellcheck disable=SC1007
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$SELF")" && pwd)
# shellcheck disable=SC1007
DOTFILES_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)

WORK_DOTFILES_ROOT=${WORK_DOTFILES_ROOT:-"$HOME/work/.dotfiles"}

XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-"$HOME/.config"}
LOCAL_BIN=${LOCAL_BIN:-"$HOME/.local/bin"}

BACKUP_DIR="$DOTFILES_ROOT/.backup/$(date "+%Y%m%d-%H%M%S")"

usage() {
  cat <<EOF
Manage symlinks for dotfiles repository located at $DOTFILES_ROOT.

Usage: $(basename "$0") <command>

Commands:
  link     create/replace symlinks, backing up real files into .backup/<ts>/
  unlink   remove current symlinks managed by this script
  status   report OK/MISS/DIFF/FILE for expected links
  prune    delete broken symlinks that pointed into dotfiles/work-dotfiles
EOF
}

say() { printf "%s\n" "$*"; }

die() { printf "error: %s\n" "$*" >&2; exit 1; }

ensure_dir() { [ -d "$1" ] || mkdir -p "$1"; }

backup_if_needed() {
  dest=$1

  # Replace an existing symlink unconditionally.
  # This makes repeated runs idempotent and avoids stale link targets.
  if [ -L "$dest" ]; then
    rm -f "$dest"
    return 0
  fi

  # If a regular file/directory exists, move it out of the way.
  if [ -e "$dest" ]; then
    ensure_dir "$BACKUP_DIR"
    say "backup $dest -> $BACKUP_DIR/"
    mv "$dest" "$BACKUP_DIR/"
  fi
}

is_darwin() {
  [ -x "$DOTFILES_ROOT/bin/is-darwin" ] || return 1
  "$DOTFILES_ROOT/bin/is-darwin"
}

os_id() {
  if is_darwin; then
    printf "darwin"
  else
    printf ""
  fi
}

is_work_machine() {
  [ -x "$DOTFILES_ROOT/bin/is-work" ] && "$DOTFILES_ROOT/bin/is-work"
}

resolve_src_rel() {
  rel=$1
  os=$(os_id)

  # Higher-priority candidates are appended first.
  candidates=""

  if is_work_machine && [ -d "$WORK_DOTFILES_ROOT" ]; then
    if [ -n "$os" ]; then
      candidates="$candidates $WORK_DOTFILES_ROOT/$os/$rel"
    fi
    candidates="$candidates $WORK_DOTFILES_ROOT/$rel"
  fi

  if [ -n "$os" ]; then
    candidates="$candidates $DOTFILES_ROOT/$os/$rel"
  fi

  candidates="$candidates $DOTFILES_ROOT/$rel"

  for path in $candidates; do
    if [ -e "$path" ]; then
      printf '%s' "$path"
      return 0
    fi
  done

  # Fallback to the first candidate even if none exist yet.
  for path in $candidates; do
    printf '%s' "$path"
    return 0
  done
}

link_one() {
  rel=$1
  src=$(resolve_src_rel "$rel")
  dest=$2

  ensure_dir "$(dirname "$dest")"
  backup_if_needed "$dest"
  ln -s "$src" "$dest"
  say "link   $dest -> $src"
}

unlink_one() {
  dest=$1
  if [ -L "$dest" ]; then
    rm -f "$dest"
    say "unlink $dest"
  fi
}

status_one() {
  rel=$1
  src=$(resolve_src_rel "$rel")
  dest=$2

  if [ ! -e "$dest" ]; then
    say "MISS  $dest"
    return 1
  fi

  if [ -L "$dest" ]; then
    got=$(readlink "$dest" 2>/dev/null || true)
    if [ "$got" = "$src" ]; then
      say "OK    $dest -> $got"
      return 0
    fi
    say "DIFF  $dest -> $got (expected $src)"
    return 1
  fi

  say "FILE  $dest (not a symlink)"
  return 1
}

collect_names() {
  # Args: list of directories to scan. Emits basename per entry, one per line.
  for dir in "$@"; do
    [ -d "$dir" ] || continue
    for entry in "$dir/"*; do
      [ -e "$entry" ] || continue
      basename "$entry"
    done
  done | sort -u
}

config_names() {
  os=$(os_id)
  dirs="$DOTFILES_ROOT/.config"
  [ -n "$os" ] && dirs="$dirs $DOTFILES_ROOT/$os/.config"

  if is_work_machine && [ -d "$WORK_DOTFILES_ROOT" ]; then
    dirs="$dirs $WORK_DOTFILES_ROOT/.config"
    [ -n "$os" ] && dirs="$dirs $WORK_DOTFILES_ROOT/$os/.config"
  fi

  # shellcheck disable=SC2086
  collect_names $dirs
}

# Link all entries under .config/ into ~/.config/.
link_config() {
  ensure_dir "$XDG_CONFIG_HOME"

  while IFS= read -r name || [ -n "$name" ]; do
    [ -n "$name" ] || continue
    rel=".config/$name"
    dest="$XDG_CONFIG_HOME/$name"
    link_one "$rel" "$dest"
  done <<EOF
$(config_names)
EOF

  # zsh bootstrap: keep .zshenv in $HOME so ZDOTDIR works before ~/.config/zsh
  # is even consulted.
  link_one ".config/zsh/.zshenv" "$HOME/.zshenv"
}

# Remove only the symlinks for entries that currently exist in this repo.
#
# If a config entry was removed from the repo, the corresponding symlink might
# remain; use "prune" to clean up broken leftovers.
unlink_config() {
  while IFS= read -r name || [ -n "$name" ]; do
    [ -n "$name" ] || continue
    dest="$XDG_CONFIG_HOME/$name"
    unlink_one "$dest"
  done <<EOF
$(config_names)
EOF
  unlink_one "$HOME/.zshenv"
}

status_config() {
  fail=0
  while IFS= read -r name || [ -n "$name" ]; do
    [ -n "$name" ] || continue
    rel=".config/$name"
    dest="$XDG_CONFIG_HOME/$name"
    status_one "$rel" "$dest" || fail=1
  done <<EOF
$(config_names)
EOF
  status_one ".config/zsh/.zshenv" "$HOME/.zshenv" || fail=1
  return "$fail"
}

bin_names() {
  os=$(os_id)
  dirs="$DOTFILES_ROOT/bin"
  [ -n "$os" ] && dirs="$dirs $DOTFILES_ROOT/$os/bin"

  if is_work_machine && [ -d "$WORK_DOTFILES_ROOT" ]; then
    dirs="$dirs $WORK_DOTFILES_ROOT/bin"
    [ -n "$os" ] && dirs="$dirs $WORK_DOTFILES_ROOT/$os/bin"
  fi

  # shellcheck disable=SC2086
  collect_names $dirs
}

link_bin() {
  ensure_dir "$LOCAL_BIN"

  while IFS= read -r name || [ -n "$name" ]; do
    [ -n "$name" ] || continue
    rel="bin/$name"
    dest="$LOCAL_BIN/$name"
    link_one "$rel" "$dest"
  done <<EOF
$(bin_names)
EOF
}

unlink_bin() {
  while IFS= read -r name || [ -n "$name" ]; do
    [ -n "$name" ] || continue
    unlink_one "$LOCAL_BIN/$name"
  done <<EOF
$(bin_names)
EOF
}

status_bin() {
  fail=0

  while IFS= read -r name || [ -n "$name" ]; do
    [ -n "$name" ] || continue
    rel="bin/$name"
    dest="$LOCAL_BIN/$name"
    status_one "$rel" "$dest" || fail=1
  done <<EOF
$(bin_names)
EOF

  return "$fail"
}

# Remove ONLY broken symlinks under ~/.config that were pointing into
# $DOTFILES_ROOT/.config/ or $WORK_DOTFILES_ROOT/.config/.
#
# This approximates "remove configs deleted from dotfiles" because removing
# a config entry from the repo typically breaks the corresponding symlink.
prune_config() {
  os=$(os_id)

  config_prefixes="$DOTFILES_ROOT/.config $WORK_DOTFILES_ROOT/.config"
  [ -n "$os" ] && config_prefixes="$config_prefixes $DOTFILES_ROOT/$os/.config $WORK_DOTFILES_ROOT/$os/.config"

  for p in "$XDG_CONFIG_HOME"/*; do
    [ -L "$p" ] || continue
    [ -e "$p" ] && continue

    target=$(readlink "$p" 2>/dev/null || true)

    for prefix in $config_prefixes; do
      case "$target" in
        "$prefix"/*)
          rm -f "$p"
          say "prune  $p"
          break
          ;;
      esac
    done
  done

  # Also prune $HOME/.zshenv if it became a broken link pointing into dotfiles.
  if [ -L "$HOME/.zshenv" ] && [ ! -e "$HOME/.zshenv" ]; then
    target=$(readlink "$HOME/.zshenv" 2>/dev/null || true)
    for prefix in $config_prefixes; do
      case "$target" in
        "$prefix"/zsh/.zshenv)
          rm -f "$HOME/.zshenv"
          say "prune  $HOME/.zshenv"
          break
          ;;
      esac
    done
  fi
}

# Remove ONLY broken symlinks under ~/.local/bin that were pointing into
# $DOTFILES_ROOT/bin/ or $WORK_DOTFILES_ROOT/bin/.
prune_bin() {
  os=$(os_id)

  bin_prefixes="$DOTFILES_ROOT/bin $WORK_DOTFILES_ROOT/bin"
  [ -n "$os" ] && bin_prefixes="$bin_prefixes $DOTFILES_ROOT/$os/bin $WORK_DOTFILES_ROOT/$os/bin"

  for p in "$LOCAL_BIN"/*; do
    [ -L "$p" ] || continue
    [ -e "$p" ] && continue

    target=$(readlink "$p" 2>/dev/null || true)

    for prefix in $bin_prefixes; do
      case "$target" in
        "$prefix"/*)
          rm -f "$p"
          say "prune  $p"
          break
          ;;
      esac
    done
  done
}

cmd=${1:-help}
case "$cmd" in
  link)
    # Link binaries first so repo-local helper scripts are available early.
    link_bin
    link_config
    ;;
  unlink)
    unlink_bin
    unlink_config
    ;;
  status)
    fail=0
    status_config || fail=1
    status_bin || fail=1
    exit "$fail"
    ;;
  prune)
    prune_bin
    prune_config
    ;;
  help|--help|-h|"")
    usage
    ;;
  *)
    die "unrecognized command: $cmd"
    ;;
esac
