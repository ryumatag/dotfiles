# PATH/MANPATH setup shared by bash/zsh

# shellcheck disable=SC2123
PATH=""

# Prepend a directory to PATH if it exists and is not already present.
path_prepend() {
  [ -d "$1" ] || return 0
  case ":$PATH:" in
    *":$1:"*) ;;
    *) PATH="$1:$PATH" ;;
  esac
}

# Prepend a directory to MANPATH if it exists and is not already present.
manpath_prepend() {
  [ -d "$1" ] || return 0
  case ":${MANPATH-}:" in
    *":$1:"*) ;;
    *) MANPATH="$1${MANPATH:+:$MANPATH}" ;;
  esac
}

# Common locations (only added if they exist).
path_prepend /sbin
path_prepend /bin
path_prepend /usr/sbin
path_prepend /usr/bin
path_prepend /usr/local/sbin
path_prepend /usr/local/bin
path_prepend /usr/local/go/bin

# User locations.
path_prepend "$HOME/.local/bin"
path_prepend "$HOME/.local/share/go/bin"
path_prepend "$HOME/.cargo/bin"

# Homebrew
if [ -d "/opt/homebrew" ]; then
  export HOMEBREW_PREFIX="/opt/homebrew"
  export HOMEBREW_CELLAR="/opt/homebrew/Cellar"
  export HOMEBREW_REPOSITORY="/opt/homebrew"
  export INFOPATH="/opt/homebrew/share/info:${INFOPATH:-}"

  # Prefer GNU tools from Homebrew when available.
  for bindir in "$HOMEBREW_PREFIX"/opt/*/libexec/gnubin; do
    [ -d "$bindir" ] || continue
    path_prepend "$bindir"
  done

  path_prepend "$HOMEBREW_PREFIX/sbin"
  path_prepend "$HOMEBREW_PREFIX/bin"

  for mandir in "$HOMEBREW_PREFIX"/opt/*/libexec/gnuman; do
    [ -d "$mandir" ] || continue
    manpath_prepend "$mandir"
  done
  manpath_prepend "$HOMEBREW_PREFIX/share/man"
fi

export PATH
export MANPATH
